{
  "name": "hollr",
  "productName": "Hollr",
  "version": "0.1.0",
  "description": "Voice-controlled Twitch polls and predictions, with an in-app chat bot. Speech recognition runs locally.",
  "author": "Axeex",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "ng build --configuration production",
    "build:electron": "electron-vite build && vite build --config vite.worker.config.mts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stt": "vitest run --config vitest.stt.config.mts",
    "test:clips": "powershell -ExecutionPolicy Bypass -File scripts/make-test-clips.ps1",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "sherpa-onnx-node": "2.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.0.8"
  }
}
